<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>OElite.Restme RabbitMQ provider implementation</Description>
        <TargetFrameworks>net9.0;net8.0</TargetFrameworks>
        <AssemblyVersion>2.0.5</AssemblyVersion>
        <VersionPrefix>2.0.5</VersionPrefix>
        <AssemblyName>OElite.Restme.RabbitMQ</AssemblyName>
        <PackageTags>OElite;Restme;RabbitMQ;Queue</PackageTags>
        <RepositoryUrl>https://oelite.visualstudio.com/Uranus</RepositoryUrl>
        <Authors>OElite Limited</Authors>
        <Copyright>OElite Limited</Copyright>
        <PackageProjectUrl>https://www.oelite.com</PackageProjectUrl>
        <Title>OElite.Restme.RabbitMQ</Title>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="RabbitMQ.Client" Version="6.2.4" />
    </ItemGroup>
    
    <ItemGroup>
        <ProjectReference Include="..\OElite.Restme\OElite.Restme.csproj" />
    </ItemGroup>
</Project>
