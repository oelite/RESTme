<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>OElite.Restme S3 provider implementation</Description>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <AssemblyVersion>2.1.0</AssemblyVersion>
        <VersionPrefix>2.1.0</VersionPrefix>
        <AssemblyName>OElite.Restme.S3</AssemblyName>
        <PackageTags>OElite;Restme;S3;AWS;Storage</PackageTags>
        <RepositoryUrl>https://oelite.visualstudio.com/Uranus</RepositoryUrl>
        <Authors>OElite Limited</Authors>
        <Copyright>OElite Limited</Copyright>
        <PackageProjectUrl>https://www.oelite.com</PackageProjectUrl>
        <Title>OElite.Restme.S3</Title>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="AWSSDK.S3" Version="3.7.401" />
    </ItemGroup>
    
    <ItemGroup>
        <ProjectReference Include="..\OElite.Restme\OElite.Restme.csproj" />
    </ItemGroup>
</Project>
