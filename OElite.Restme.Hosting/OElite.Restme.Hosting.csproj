<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>ASP.NET Core integration extensions for OElite.Restme - provides DI registration, IDistributedCache adapters, and middleware</Description>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <AssemblyVersion>2.0.9</AssemblyVersion>
        <VersionPrefix>2.0.9</VersionPrefix>
        <PackageTags>OElite;Restme;AspNetCore;DependencyInjection;Cache;Redis</PackageTags>
        <RepositoryUrl>https://oelite.visualstudio.com/Uranus</RepositoryUrl>
        <Authors>OElite Limited</Authors>
        <Copyright>OElite Limited</Copyright>
        <PackageProjectUrl>https://www.oelite.com</PackageProjectUrl>
        <Title>OElite.Restme.Hosting</Title>
        <Nullable>enable</Nullable>
        <PackageId>OElite.Restme.Hosting</PackageId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="9.0.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\OElite.Restme\OElite.Restme.csproj" />
        <ProjectReference Include="..\OElite.Restme.Redis\OElite.Restme.Redis.csproj" />
    </ItemGroup>
</Project>
