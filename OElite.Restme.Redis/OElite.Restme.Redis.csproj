<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>OElite.Restme Redis provider implementation</Description>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <AssemblyVersion>2.1.0</AssemblyVersion>
        <VersionPrefix>2.1.0</VersionPrefix>
        <AssemblyName>OElite.Restme.Redis</AssemblyName>
        <PackageTags>OElite;Restme;Redis;Cache</PackageTags>
        <RepositoryUrl>https://oelite.visualstudio.com/Uranus</RepositoryUrl>
        <Authors>Phanes Technology Ltd</Authors>
        <Copyright>Phanes Technology Ltd</Copyright>
        <PackageProjectUrl>https://www.oelite.com</PackageProjectUrl>
        <Title>OElite.Restme.Redis</Title>
        <Nullable>enable</Nullable>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="StackExchange.Redis" Version="2.9.17" />
    </ItemGroup>
    
    <ItemGroup>
        <ProjectReference Include="..\OElite.Restme\OElite.Restme.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>
</Project>
